# /etc/zeus/zeus.env (chmod 0600, chủ sở hữu root:zeus). KHÔNG commit file thật. Không có giá trị secret mặc định.
ZEUS_ENV=prod
ZEUS_DB_DSN=host=127.0.0.1 port=5432 dbname=zeus user=zeus
ZEUS_DB_POOL_MAX=10          # pool kết nối Postgres dùng chung mỗi tiến trình (0 = tắt); mỗi tiến trình API/control-worker một pool
ZEUS_TEMPORAL_ADDRESS=127.0.0.1:7233
ZEUS_TEMPORAL_NAMESPACE=default
ZEUS_DATA_DIR=/var/lib/zeus
ZEUS_ARTIFACT_DIR=/var/lib/zeus/artifacts
ZEUS_MIGRATIONS_DIR=/opt/zeus/app/migrations
ZEUS_MODELS_CONFIG=/opt/zeus/app/config/models.yaml
ZEUS_POLICY_CONFIG=/opt/zeus/app/config/policy.yaml
ZEUS_BRAIN_CONFIG=/opt/zeus/app/config/brain.yaml
ZEUS_WORKERS_CONFIG=/opt/zeus/app/config/workers.yaml
ZEUS_CHANNELS_CONFIG=/opt/zeus/app/config/channels.yaml
CLAUDE_CLOUD_AVAILABLE=false
# Bearer token cho /api/v1 và /internal (bắt buộc khi ZEUS_ENV=prod/staging): openssl rand -hex 32
ZEUS_API_TOKEN=
# Workbench: băm bằng `python -m zeus.app.admin hash-password`; khoá phiên chung: openssl rand -hex 32
ZEUS_WB_PASSWORD_HASH=
ZEUS_WB_SESSION_KEY=
ZEUS_WB_SECURE_COOKIES=1
# Model local (llama.cpp trên zeus-gpu) — để trống => intent/planner/critic/judge chạy deterministic
ZEUS_LOCAL_LLM_URL=
ZEUS_LOCAL_LLM_MODEL=
# Cloud LLM: tuỳ chọn (gate G12). Để trống => không gọi cloud.
ZEUS_ALLOW_CLOUD_LLM=false
ANTHROPIC_API_KEY=
# Secret kênh (thiếu => kênh tắt, webhook 404): xem config/channels.yaml
ZEUS_ZALO_BOT_SECRET_TOKEN=
ZEUS_ZALO_BOT_TOKEN=
