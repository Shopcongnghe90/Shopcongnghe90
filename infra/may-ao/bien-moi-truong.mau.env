# Sao chép thành bien-moi-truong.env (đã bị .gitignore) rồi điền giá trị.
#   cp bien-moi-truong.mau.env bien-moi-truong.env && chmod 600 bien-moi-truong.env
# Mọi script trong thư mục này tự nạp bien-moi-truong.env nếu có.
# KHÔNG có token/API key của Claude hay nhà cung cấp model ở đây: thin worker không giữ chúng.

# --- Cổng rủi ro host (ADR-012) ---------------------------------------------
# Mã quyết định G1/G2/G3 của người duyệt. Thiếu => script thay đổi host TỪ CHỐI chạy thật.
ZEUS_G1_DUYET=
# RAM còn trống tối thiểu (GiB) để dám thay đổi host đang chạy ERP production.
RAM_TOI_THIEU_ERP_GIB=20

# --- Thin worker -------------------------------------------------------------
# URL Worker API (zeus-core trên br-core). Token riêng từng worker nằm ở bi-mat/<may>.token (0600), KHÔNG ở đây.
ZEUS_SERVER_URL=http://10.90.30.10:8080

# --- Lưu trữ cho Incus -------------------------------------------------------
# Ổ đĩa/phân vùng TRỐNG dành riêng cho pool ZFS (kiến trúc: ổ D), ví dụ /dev/nvme1n1.
# Để trống => tệp loop kích cỡ KICH_CO_POOL (chậm hơn, chỉ để thử).
O_DIA_ZFS=
KICH_CO_POOL=600GiB
# Giới hạn ZFS ARC trên host (byte). 4 GiB.
ZFS_ARC_MAX=4294967296

# --- Người dùng được quản trị Incus (nhóm incus-admin) -----------------------
NGUOI_DUNG_INCUS=

# --- Mạng -------------------------------------------------------------------
# Đổi ở đây PHẢI đổi đồng bộ trong incus/preseed.yaml, mang/cach-ly-mang.nft, may/*.yaml
