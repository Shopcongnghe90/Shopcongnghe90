# Sao chép thành bien-moi-truong.env (đã bị .gitignore) rồi điền giá trị.
#   cp bien-moi-truong.mau.env bien-moi-truong.env && chmod 600 bien-moi-truong.env
# Mọi script trong thư mục này tự nạp bien-moi-truong.env nếu có.

# --- Claude Code ------------------------------------------------------------
# Token lấy bằng `claude setup-token` trên máy admin (cần gói Pro/Max/Team).
# Dùng chung cho 7 máy hoặc tạo riêng từng máy đều được.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Mật khẩu ---------------------------------------------------------------
# Mật khẩu noVNC/VNC cho các máy Linux (tối đa 8 ký tự có ý nghĩa với VNC).
VNC_MAT_KHAU=
# Mật khẩu tài khoản `agent` trên Windows (ghi vào autounattend.xml).
WIN_MAT_KHAU=

# --- Lưu trữ cho Incus ------------------------------------------------------
# Ổ đĩa/phân vùng TRỐNG dành riêng cho pool ZFS, ví dụ /dev/nvme1n1.
# Để trống => dùng tệp loop kích cỡ KICH_CO_POOL (chậm hơn, chỉ nên để thử).
O_DIA_ZFS=
KICH_CO_POOL=600GiB
# Giới hạn ZFS ARC trên host (byte). 6 GiB mặc định.
ZFS_ARC_MAX=6442450944

# --- Người dùng được quản trị Incus (thêm vào nhóm incus-admin) -------------
NGUOI_DUNG_INCUS=

# --- Windows ----------------------------------------------------------------
# ISO Windows 11 gốc tải từ Microsoft (tự tải, cần giấy phép hợp lệ).
WIN_ISO=/var/lib/may-ao/iso/Win11.iso
# Thư mục chứa ISO đã đóng gói lại + ISO autounattend.
THU_MUC_ISO=/var/lib/may-ao/iso

# --- Mạng -------------------------------------------------------------------
# Thay đổi ở đây PHẢI đổi đồng bộ trong incus/preseed.yaml, mang/cach-ly-erp.nft, may/*.yaml
MANG_AGENT=10.90.10.0/24
MANG_ERP=10.90.20.0/24
